    <item>
      <title>Bataille d&#39;Actium</title>
      <link>http://localhost:1313/antiquite/actium/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/antiquite/actium/</guid>
      <description>&lt;h2 id=&#34;le-contexte&#34;&gt;Le contexte&lt;/h2&gt;&#xA;&lt;p&gt;Après la mort de César, Rome se déchire. Octave et Marc Antoine se disputent le pouvoir.&lt;/p&gt;&#xA;&#xA;&#xA;&lt;ol class=&#34;frise&#34;&gt;&#xA;  &#xA;  &lt;li&gt;&#xA;    &lt;time&gt;31 av. J.-C.&lt;/time&gt;&#xA;    &lt;h3&gt;Blocus&lt;/h3&gt;&#xA;    &lt;p&gt;La flotte d&amp;#39;Agrippa coupe les approvisionnements d&amp;#39;Antoine.&lt;/p&gt;&#xA;  &lt;/li&gt;&#xA;  &#xA;  &lt;li&gt;&#xA;    &lt;time&gt;2 septembre 31&lt;/time&gt;&#xA;    &lt;h3&gt;Bataille d&amp;#39;Actium&lt;/h3&gt;&#xA;    &lt;p&gt;Antoine tente de forcer le blocus ; Cléopâtre et une partie de sa flotte s&amp;#39;échappent.&lt;/p&gt;&#xA;  &lt;/li&gt;&#xA;  &#xA;  &lt;li&gt;&#xA;    &lt;time&gt;30 av. J.-C.&lt;/time&gt;&#xA;    &lt;h3&gt;Alexandrie&lt;/h3&gt;&#xA;    &lt;p&gt;Antoine et Cléopâtre se donnent la mort ; l&amp;#39;Égypte devient romaine.&lt;/p&gt;&#xA;  &lt;/li&gt;&#xA;  &#xA;  &lt;li&gt;&#xA;    &lt;time&gt;27 av. J.-C.&lt;/time&gt;&#xA;    &lt;h3&gt;Naissance de l&amp;#39;Empire&lt;/h3&gt;&#xA;    &lt;p&gt;Octave reçoit le titre d&amp;#39;Auguste.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Bataille de Gaugamèles</title>
      <link>http://localhost:1313/antiquite/gaugameles/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/antiquite/gaugameles/</guid>
      <description>&lt;h2 id=&#34;le-contexte&#34;&gt;Le contexte&lt;/h2&gt;&#xA;&lt;p&gt;Après Le Granique et Issos, Alexandre contrôle déjà l&amp;rsquo;Asie Mineure, la Syrie et l&amp;rsquo;Égypte.&#xA;Darius III réunit alors une immense armée sur un terrain plat, choisi pour favoriser sa cavalerie&#xA;et ses chars à faux.&lt;/p&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&lt;figure class=&#34;carte&#34;&gt;&#xA;  &lt;div class=&#34;carte-wrap&#34;&gt;&#xA;    &lt;img src=&#34;http://localhost:1313/images/carte-gaugameles.jpg&#34; alt=&#34;Carte des conquêtes d&amp;#39;Alexandre le Grand&#34; loading=&#34;lazy&#34;&gt;&#xA;    &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &lt;button type=&#34;button&#34; class=&#34;carte-point&#34;&#xA;        style=&#34;left:15.8%;top:29.2%&#34;&#xA;        data-titre=&#34;Le Granique, 334&#34; data-texte=&#34;Première grande victoire en Asie : Alexandre ouvre l&amp;#39;Asie Mineure.&#34;&#xA;        aria-label=&#34;Le Granique, 334&#34;&gt;1&lt;/button&gt;&#xA;    &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &lt;button type=&#34;button&#34; class=&#34;carte-point&#34;&#xA;        style=&#34;left:28.9%;top:42.3%&#34;&#xA;        data-titre=&#34;Issos, 333&#34; data-texte=&#34;Première rencontre avec Darius III en personne, qui s&amp;#39;enfuit.&#34;&#xA;        aria-label=&#34;Issos, 333&#34;&gt;2&lt;/button&gt;&#xA;    &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &lt;button type=&#34;button&#34; class=&#34;carte-point&#34;&#xA;        style=&#34;left:40.7%;top:44.8%&#34;&#xA;        data-titre=&#34;Gaugamèles, 331&#34; data-texte=&#34;La bataille décisive : le cœur de l&amp;#39;empire perse est ouvert.&#34;&#xA;        aria-label=&#34;Gaugamèles, 331&#34;&gt;3&lt;/button&gt;&#xA;    &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &#xA;      &lt;button type=&#34;button&#34; class=&#34;carte-point&#34;&#xA;        style=&#34;left:87.6%;top:39.1%&#34;&#xA;        data-titre=&#34;L&amp;#39;Hydaspe, 326&#34; data-texte=&#34;Victoire sur le roi Pôros, aux portes de l&amp;#39;Inde.&#34;&#xA;        aria-label=&#34;L&amp;#39;Hydaspe, 326&#34;&gt;4&lt;/button&gt;&#xA;    &#xA;  &lt;/div&gt;&#xA;  &lt;div class=&#34;carte-info&#34; aria-live=&#34;polite&#34;&gt;&#xA;    &lt;p class=&#34;carte-aide&#34;&gt;Clique sur un point numéroté pour en savoir plus.&lt;/p&gt;</description>
